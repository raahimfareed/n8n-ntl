# =============================================================================
# Postgres
# =============================================================================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# =============================================================================
# n8n Core
# =============================================================================
N8N_HOST=n8n.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https

# Generate with: openssl rand -hex 32
# WARNING: Changing this after first run makes all saved credentials unreadable
N8N_ENCRYPTION_KEY=change_me

# Full public URL for webhooks
# Reverse proxy:  https://n8n.yourdomain.com/
# Cloudflare Tunnel: https://n8n.yourdomain.com/
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/

# =============================================================================
# Security
# =============================================================================
# Always true when behind HTTPS (reverse proxy or CF Tunnel)
N8N_SECURE_COOKIE=true

# Reverse proxy: count your proxy hops (nginx/caddy/traefik = 1)
# Cloudflare Tunnel: 1 (the tunnel itself is the hop)
# Reverse proxy + CF Tunnel: 2
N8N_PROXY_HOPS=1

# =============================================================================
# Timezone
# =============================================================================
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Karachi
