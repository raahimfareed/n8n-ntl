# Postgres / DB
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# n8n Core
N8N_HOST=n8n.yourdomain.com
N8N_PORT=5678
N8N_PROTOCOL=https
# Generate with: openssl rand -hex 32
# WARNING: Never change this after first run or all saved credentials will be lost
N8N_ENCRYPTION_KEY=change_me

# Webhook
# If using Cloudflare Tunnel, set this to your CF public domain
WEBHOOK_URL=https://n8n.yourdomain.com/

# Executions
EXECUTIONS_TIMEOUT=3600

# Security
# Set to false only if not behind HTTPS (local dev)
N8N_SECURE_COOKIE=true
# Number of reverse proxy hops before n8n (CF Tunnel counts as 1)
N8N_PROXY_HOPS=1

# Timezone
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Asia/Karachi
